#!/usr/bin/env node
const render = require('../lib/render')
const all = Promise.all.bind(Promise)

const cli = require('meow')(`
  Usage:
    $ kingraph INPUT.yml

  Options:
    -h, --help         show usage information
    -v, --version      print version info and exit
    -F, --format=svg   format (dot, svg, png)
`, {
  flags: {
    help: { type: 'boolean', alias: 'h' },
    version: { type: 'boolean', alias: 'v' },
    format: { type: 'string', alias: 'F', default: 'svg' }
  }
})

require('read-input')(cli.input)
.then(res => {
  return all(res.files.map(file => {
    const input = require('js-yaml').load(file.data)
    const format = cli.flags.format || 'svg'

    return render(input, { format })
      .then(result => {
        process.stdout.write(result)
      })
  }))
})
.catch(err => {
  console.error(err)
  process.exit(8)
})
